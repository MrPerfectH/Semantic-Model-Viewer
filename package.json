{
  "name": "semantic-model-viewer-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Offline semantic model snapshots and agent-authored visual explanations",
  "bin": {
    "smv": "bin/smv.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/cli.test.cjs tests/explanations.test.cjs tests/explanation-session.test.cjs tests/interactive-view.test.cjs tests/mcp-viewer.test.cjs",
    "test:browser": "node --test tests/explanations.browser.cjs",
    "build:mcp-app": "node scripts/build-mcp-app.cjs",
    "test:interactive": "node --test tests/interactive-view.browser.cjs",
    "prepack": "npm run build:mcp-app"
  },
  "files": [
    "bin/",
    "Models/tools/viewer/index.html",
    "Models/tools/viewer/*.css",
    "Models/tools/viewer/js/",
    "Models/tools/viewer/scripts/cli/",
    "docs/cli.md",
    "docs/snapshots.md",
    "Models/tools/viewer/scripts/scan_report_usage.py",
    "docs/visual-explanations.md",
    "skills/smv-explain/",
    "examples/explanations/",
    "Models/demo/",
    "docs/interactive-viewer.md",
    "integrations/mcp/"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

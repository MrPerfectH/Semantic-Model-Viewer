{
  "name": "semantic-model-viewer-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Offline semantic model snapshots and agent-authored visual explanations",
  "bin": {
    "smv": "bin/smv.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/cli-delivery.test.cjs tests/agent-delivery.test.cjs tests/cli.test.cjs tests/open-model.test.cjs tests/explanations.test.cjs tests/explanation-session.test.cjs tests/interactive-view.test.cjs tests/mcp-viewer.test.cjs tests/claude-plugin.test.cjs tests/browser-defaults.test.cjs tests/full-workflow.test.cjs tests/cli-workspace.test.cjs tests/measure-comparison.test.cjs",
    "test:browser": "node --test tests/explanations.browser.cjs tests/measure-comparison.browser.cjs tests/diagram-readability.browser.cjs",
    "build:mcp-app": "node scripts/build-mcp-app.cjs",
    "test:interactive": "node --test tests/interactive-view.browser.cjs",
    "test:marketplace": "node scripts/test-claude-marketplace.cjs",
    "test:plugin": "node --test tests/claude-plugin.test.cjs",
    "build:plugin": "node scripts/build-claude-plugin.cjs",
    "build:portable": "node scripts/build-portable.cjs",
    "build:codex-plugin": "node scripts/build-codex-plugin.cjs",
    "build:vscode-cli": "node scripts/build-vscode-cli.cjs"
  },
  "files": [
    ".claude-plugin/",
    "bin/",
    "scripts/open-model.cjs",
    "Models/tools/viewer/index.html",
    "Models/tools/viewer/*.css",
    "Models/tools/viewer/js/",
    "Models/tools/viewer/scripts/cli/",
    "Models/tools/viewer/scripts/scan_report_usage.py",
    "docs/cli.md",
    "docs/snapshots.md",
    "docs/visual-explanations.md",
    "skills/smv-explain/",
    "skills/open/",
    "skills/explain/",
    "skills/snapshot/",
    "docs/claude-code-plugin.md",
    "examples/explanations/",
    "Models/demo/",
    "scripts/claude-workspace.cjs",
    "docs/cli-plugin-workflow.md",
    "skills/stop/",
    "skills/setup/",
    "docs/cli-workspace-fetch.md",
    "packages/engine/",
    "runtime/node-lock.json",
    "docs/bundled-agent-delivery.md",
    "docs/codex-plugin.md",
    "docs/measure-comparison.md"
  ],
  "devDependencies": {
    "esbuild": "0.28.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  }
}

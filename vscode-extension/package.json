{
  "name": "semantic-model-viewer",
  "displayName": "Semantic Model Viewer",
  "description": "Explore Power BI semantic models: tables and relationships, measure dependencies and DAX, and Power Query lineage. Save interactive HTML snapshots for offline sharing.",
  "version": "0.3.8",
  "license": "MIT",
  "publisher": "MrPerfectH",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrPerfectH/Semantic-Model-Viewer"
  },
  "bugs": {
    "url": "https://github.com/MrPerfectH/Semantic-Model-Viewer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "power bi",
    "power query",
    "m language",
    "tmdl",
    "pbip",
    "semantic model",
    "dax",
    "fabric"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "semanticModelViewer.open",
        "title": "Open Model…",
        "category": "Semantic Model Viewer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "semanticModelViewer.openFolder",
        "title": "Open in Semantic Model Viewer",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.refresh",
        "title": "Refresh Model",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.openEntry",
        "title": "Open in Semantic Model Viewer",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.refreshModels",
        "title": "Refresh Model List",
        "category": "Semantic Model Viewer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "semanticModelViewer.openFolder",
          "when": "explorerResourceIsFolder && resourceFilename =~ /\\.SemanticModel$/ || resourceFilename == model.bim",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "semanticModelViewer.openFolder",
          "when": "false"
        },
        {
          "command": "semanticModelViewer.openEntry",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "semanticModelViewer.refreshModels",
          "when": "view == semanticModelViewer.models",
          "group": "navigation@1"
        },
        {
          "command": "semanticModelViewer.open",
          "when": "view == semanticModelViewer.models",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Semantic Model Viewer",
      "properties": {
        "semanticModelViewer.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `*.SemanticModel` folder or a `model.bim` to open by default, absolute or relative to the workspace folder. Leave empty to choose from the models found in the workspace."
        },
        "semanticModelViewer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns to skip when looking for models, e.g. `**/Archive/**`. Hidden folders (`.worktrees`, `.pbi`, `.venv`…), `node_modules` and `.git` are always skipped."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "semanticModelViewer",
          "title": "Semantic Models",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "semanticModelViewer": [
        {
          "id": "semanticModelViewer.models",
          "name": "Semantic Models",
          "icon": "images/activity.svg",
          "contextualTitle": "Semantic Models"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "semanticModelViewer.models",
        "contents": "No *.SemanticModel folder or model.bim found in the open workspace.\n\nOpen a folder that contains a Power BI project (.pbip) and the models appear here.\n[Refresh](command:semanticModelViewer.refreshModels)"
      }
    ]
  },
  "scripts": {
    "sync-viewer": "node scripts/sync-viewer.js",
    "check-viewer": "node scripts/sync-viewer.js --check",
    "vscode:prepublish": "npm run sync-viewer",
    "package": "vsce package",
    "test": "npm run sync-viewer && npm run check-viewer && node --test --test-concurrency=1 ../tests/*.test.cjs ../tests/extension.test.js ../Models/tools/viewer/tests/*.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0"
  },
  "icon": "images/icon.png"
}

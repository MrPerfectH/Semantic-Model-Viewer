{
  "name": "semantic-model-viewer",
  "displayName": "Semantic Model Viewer",
  "description": "Explore Power BI semantic models: tables and relationships, measure dependencies and DAX, and Power Query lineage. Save interactive HTML snapshots for offline sharing.",
  "version": "0.5.0",
  "license": "MIT",
  "publisher": "MrPerfectH",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrPerfectH/Semantic-Model-Viewer"
  },
  "bugs": {
    "url": "https://github.com/MrPerfectH/Semantic-Model-Viewer/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "power bi",
    "power query",
    "m language",
    "tmdl",
    "pbip",
    "semantic model",
    "dax",
    "fabric"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "semanticModelViewer.open",
        "title": "Open Model\u2026",
        "category": "Semantic Model Viewer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "semanticModelViewer.openFolder",
        "title": "Open in Semantic Model Viewer",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.refresh",
        "title": "Refresh Model",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.openEntry",
        "title": "Open in Semantic Model Viewer",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.refreshModels",
        "title": "Refresh Model List",
        "category": "Semantic Model Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "semanticModelViewer.connectFabric",
        "title": "Connect to Fabric\u2026",
        "category": "Semantic Model Viewer",
        "icon": "$(cloud)"
      },
      {
        "command": "semanticModelViewer.fabricSignOut",
        "title": "Sign Out of Fabric",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.removeFabricModel",
        "title": "Remove Saved Fabric Model\u2026",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.fabricSwitchAccount",
        "title": "Switch Fabric Account\u2026",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.fabricBrowseSignIn",
        "title": "Sign In to Browse Fabric",
        "category": "Semantic Model Viewer",
        "icon": "$(sign-in)"
      },
      {
        "command": "semanticModelViewer.refreshFabric",
        "title": "Refresh Fabric Workspaces",
        "category": "Semantic Model Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "semanticModelViewer.openFabricTreeModel",
        "title": "Open Fabric Semantic Model",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.configureExclusions",
        "title": "Exclude Workspace Model Folders\u2026",
        "category": "Semantic Model Viewer",
        "icon": "$(filter)"
      },
      {
        "command": "semanticModelViewer.installCli",
        "title": "Install CLI for External Terminals",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.connectPowerBI",
        "title": "Connect to Power BI Desktop",
        "category": "Semantic Model Viewer",
        "icon": "$(database)"
      },
      {
        "command": "semanticModelViewer.registerPowerBI",
        "title": "Add to Power BI External Tools",
        "category": "Semantic Model Viewer"
      },
      {
        "command": "semanticModelViewer.unregisterPowerBI",
        "title": "Remove from Power BI External Tools",
        "category": "Semantic Model Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "semanticModelViewer.openFolder",
          "when": "explorerResourceIsFolder && resourceFilename =~ /\\.SemanticModel$/ || resourceFilename == model.bim",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "semanticModelViewer.openFolder",
          "when": "false"
        },
        {
          "command": "semanticModelViewer.openEntry",
          "when": "false"
        },
        {
          "command": "semanticModelViewer.openFabricTreeModel",
          "when": "false"
        },
        {
          "command": "semanticModelViewer.connectPowerBI",
          "when": "semanticModelViewer.powerBIDesktop"
        },
        {
          "command": "semanticModelViewer.registerPowerBI",
          "when": "semanticModelViewer.powerBIDesktop"
        }
      ],
      "view/title": [
        {
          "command": "semanticModelViewer.refreshModels",
          "when": "view == semanticModelViewer.models",
          "group": "navigation@1"
        },
        {
          "command": "semanticModelViewer.open",
          "when": "view == semanticModelViewer.models",
          "group": "navigation@2"
        },
        {
          "command": "semanticModelViewer.configureExclusions",
          "when": "view == semanticModelViewer.models",
          "group": "navigation@3"
        },
        {
          "command": "semanticModelViewer.connectPowerBI",
          "when": "view == semanticModelViewer.models && semanticModelViewer.powerBIDesktop",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "semanticModelViewer.refreshFabric",
          "when": "view == semanticModelViewer.models && viewItem == fabricRoot",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Semantic Model Viewer",
      "properties": {
        "semanticModelViewer.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `*.SemanticModel` folder or a `model.bim` to open by default, absolute or relative to the workspace folder. Leave empty to choose from the models found in the workspace."
        },
        "semanticModelViewer.showConnectToFabricButton": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the **Connect to Fabric** button in the viewer toolbar. Off by default: in VS Code you sign in and open models from **Fabric** in the Semantic Models side bar. **Refresh Fabric** still shows when a Fabric model is open. Takes effect the next time a viewer tab opens."
        },
        "semanticModelViewer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns to skip when looking for models, e.g. `**/Archive/**` or `**/tests/fixtures/**`. Use **Exclude Workspace Model Folders\u2026** in the Semantic Model Viewer sidebar. This filters discovery only; cached Fabric models are listed separately. Hidden folders (`.worktrees`, `.pbi`, `.venv`\u2026), `node_modules` and `.git` are always skipped."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "semanticModelViewer",
          "title": "Semantic Model Viewer",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "semanticModelViewer": [
        {
          "id": "semanticModelViewer.models",
          "name": "Semantic Model Viewer",
          "icon": "images/activity.svg",
          "contextualTitle": "Semantic Model Viewer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "semanticModelViewer.models",
        "contents": "Start here: open a project folder containing a *.SemanticModel folder with TMDL definitions or model.bim. A .pbix or .pbip file alone is not supported.\n[Open folder](command:vscode.openFolder)\n[Refresh model list](command:semanticModelViewer.refreshModels)\n[Try the demo in your browser](https://MrPerfectH.github.io/Semantic-Model-Viewer/)\n[Connect to Fabric](command:semanticModelViewer.connectFabric)"
      },
      {
        "view": "semanticModelViewer.models",
        "contents": "[Connect to Power BI Desktop](command:semanticModelViewer.connectPowerBI)\n[Add to Power BI External Tools](command:semanticModelViewer.registerPowerBI)",
        "when": "semanticModelViewer.powerBIDesktop"
      }
    ],
    "languageModelTools": [
      {
        "name": "smv_discover",
        "displayName": "Semantic Model Viewer: discover",
        "toolReferenceName": "smvDiscover",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Find semantic models in the open workspace. Returns model IDs; never chooses a backup implicitly.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Find semantic models in the open workspace."
      },
      {
        "name": "smv_inspect",
        "displayName": "Semantic Model Viewer: inspect",
        "toolReferenceName": "smvInspect",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Inspect local semantic model metadata. Use a table for focused details; use show for diagrams.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "Model ID, URI or exact name from smv_discover. Omit only when exactly one current model exists."
            },
            "table": {
              "type": "string",
              "description": "Table name to explain."
            },
            "with": {
              "type": "string",
              "description": "Optional second table for a relationship diagram."
            },
            "related": {
              "type": "boolean"
            },
            "dependents": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "enum": [
                "both",
                "incoming",
                "outgoing"
              ]
            },
            "direct": {
              "type": "boolean"
            },
            "includeInactive": {
              "type": "boolean"
            }
          },
          "required": []
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Inspect local semantic model metadata."
      },
      {
        "name": "smv_relations",
        "displayName": "Semantic Model Viewer: relations",
        "toolReferenceName": "smvRelations",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Find tables filtering or filtered by a table, including direction and inactive relationships. Static metadata only.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "Model ID, URI or exact name from smv_discover. Omit only when exactly one current model exists."
            },
            "table": {
              "type": "string",
              "description": "Table name to explain."
            },
            "with": {
              "type": "string",
              "description": "Optional second table for a relationship diagram."
            },
            "related": {
              "type": "boolean"
            },
            "dependents": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "enum": [
                "both",
                "incoming",
                "outgoing"
              ]
            },
            "direct": {
              "type": "boolean"
            },
            "includeInactive": {
              "type": "boolean"
            }
          },
          "required": [
            "table"
          ]
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Find tables filtering or filtered by a table, including direction and inactive relationships."
      },
      {
        "name": "smv_dependents",
        "displayName": "Semantic Model Viewer: dependents",
        "toolReferenceName": "smvDependents",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Find calculations referencing a table and shortest chains through measures. Does not evaluate DAX.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "Model ID, URI or exact name from smv_discover. Omit only when exactly one current model exists."
            },
            "table": {
              "type": "string",
              "description": "Table name to explain."
            },
            "with": {
              "type": "string",
              "description": "Optional second table for a relationship diagram."
            },
            "related": {
              "type": "boolean"
            },
            "dependents": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "enum": [
                "both",
                "incoming",
                "outgoing"
              ]
            },
            "direct": {
              "type": "boolean"
            },
            "includeInactive": {
              "type": "boolean"
            }
          },
          "required": [
            "table"
          ]
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Find calculations referencing a table and shortest chains through measures."
      },
      {
        "name": "smv_show",
        "displayName": "Semantic Model Viewer: show",
        "toolReferenceName": "smvShow",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Open visual semantic model diagrams inside VS Code. For a known model/table call this directly, without full inspect first. Default: related tables and dependent calculations in adjacent editor panes. No CLI installation or Node on PATH is required. For two tables provide with. Panels are frozen metadata snapshots; repeat to reveal preserved exploration and read rendering status.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "Model ID, URI or exact name from smv_discover. Omit only when exactly one current model exists."
            },
            "table": {
              "type": "string",
              "description": "Table name to explain."
            },
            "with": {
              "type": "string",
              "description": "Optional second table for a relationship diagram."
            },
            "related": {
              "type": "boolean"
            },
            "dependents": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "enum": [
                "both",
                "incoming",
                "outgoing"
              ]
            },
            "direct": {
              "type": "boolean"
            },
            "includeInactive": {
              "type": "boolean"
            }
          },
          "required": [
            "table"
          ]
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Open visual semantic model diagrams inside VS Code."
      },
      {
        "name": "smv_snapshot",
        "displayName": "Semantic Model Viewer: snapshot",
        "toolReferenceName": "smvSnapshot",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Save one portable HTML diagram using a user-controlled Save dialog. Choose related:true or dependents:true. The HTML includes full-model metadata and formulas, even outside the initial diagram.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "Model ID, URI or exact name from smv_discover. Omit only when exactly one current model exists."
            },
            "table": {
              "type": "string",
              "description": "Table name to explain."
            },
            "with": {
              "type": "string",
              "description": "Optional second table for a relationship diagram."
            },
            "related": {
              "type": "boolean"
            },
            "dependents": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "enum": [
                "both",
                "incoming",
                "outgoing"
              ]
            },
            "direct": {
              "type": "boolean"
            },
            "includeInactive": {
              "type": "boolean"
            }
          },
          "required": [
            "table"
          ]
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Save one portable HTML diagram using a user-controlled Save dialog."
      },
      {
        "name": "smv_compare",
        "displayName": "Compare semantic model measures",
        "toolReferenceName": "smvCompare",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Compare two measures using native dependency diagrams and inline DAX. Includes shared and side-specific measure, table and column references. Static written definitions only; does not evaluate DAX or prove numeric equivalence. No CLI installation required.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "description": "Model ID from smv_discover; optional if only one model exists."
            },
            "measure": {
              "type": "string",
              "description": "First measure name, optionally qualified."
            },
            "with": {
              "type": "string",
              "description": "Second measure name, optionally qualified."
            }
          },
          "required": [
            "measure",
            "with"
          ],
          "additionalProperties": false
        },
        "when": "isWorkspaceTrusted",
        "userDescription": "Open paired dependency diagrams and inline DAX comparison for two measures."
      }
    ]
  },
  "scripts": {
    "sync-viewer": "node scripts/sync-viewer.js",
    "check-viewer": "node scripts/sync-viewer.js --check",
    "vscode:prepublish": "node scripts/prepare-powerbi.cjs && npm run sync-viewer",
    "package": "vsce package",
    "test": "npm run sync-viewer && npm run check-viewer && node --test --test-concurrency=1 ../tests/*.test.cjs ../tools/fabric/tests/*.test.cjs ../tests/extension.test.js ../Models/tools/viewer/tests/*.test.js",
    "package:preview": "npm run sync-viewer && node scripts/check-fabric-preview.js && vsce package --pre-release"
  },
  "devDependencies": {
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0"
  },
  "icon": "images/icon.png",
  "dependencies": {
    "@azure/msal-node": "7.0.1"
  },
  "extensionKind": [
    "ui"
  ]
}

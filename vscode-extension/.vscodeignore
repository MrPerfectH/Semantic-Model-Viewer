# Runtime allowlist: exclude development dependencies, fixtures and source models.
**/*
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!THIRD-PARTY-NOTICES.md
!images/**
!src/**
!media/index.html
!media/*.css
!media/js/*.js

!fabric/*.cjs
!fabric/xmla/publish/**

# vsce selects production dependencies; MSAL remains in the extension host.
!node_modules/**

!engine/**

!resources/windows/**

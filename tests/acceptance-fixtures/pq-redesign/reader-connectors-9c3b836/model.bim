{
  "name": "Independent wide reader and routes",
  "model": {
    "tables": [
      {
        "name": "SyntheticSales",
        "columns": [
          {
            "name": "Amount",
            "dataType": "int64",
            "sourceColumn": "Amount"
          }
        ],
        "measures": [
          {
            "name": "Base Amount",
            "expression": "SUM(SyntheticSales[Amount])"
          },
          {
            "name": "Formatted Probe",
            "expression": "VAR total=[Base Amount] RETURN DIVIDE(total,2,0)"
          }
        ],
        "partitions": [
          {
            "name": "SyntheticSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table({\"Amount\"}, {{1}, {2}}), Marker = \"PQ_REDESIGN_MAIN_PRIVATE\" in Source"
            },
            "queryGroup": "ResultGroup"
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "Sales Raw",
        "kind": "m",
        "expression": "1",
        "queryGroup": "InputGroup"
      },
      {
        "name": "Quote\"Query",
        "kind": "m",
        "expression": "2",
        "annotations": [
          {
            "name": "QueryGroup",
            "value": "FAKE/Guessed"
          }
        ]
      },
      {
        "name": "Server",
        "kind": "m",
        "expression": "\"PQ_REDESIGN_PARAMETER_ONLY\" meta [IsParameterQuery=true]",
        "queryGroup": "DeclaredOnly"
      },
      {
        "name": "OccurrenceProbe",
        "kind": "m",
        "expression": "let\r\n  Emoji = \"\ud83d\ude00\",\r\n  First = #\"Sales Raw\",\r\n  Again = #\"Sales Raw\",\r\n  Escaped = #\"Quote\"\"Query\",\r\n  EscapedCode = #\"Sales#(0020)Raw\",\r\n  Parameter = Server,\r\n  Text = \"Sales Raw Server\", // #\"Sales Raw\" Server\r\n  Local = (let #\"Sales Raw\" = 1 in #\"Sales Raw\"),\r\n  Lambda = (Server as text) => Server,\r\n  Field = [Server = \"field\"][Server],\r\n  Pad00 = \"SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_SYNTHETIC_LONG_M_00_\",\r\n  Pad01 = \"SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_SYNTHETIC_LONG_M_01_\",\r\n  Pad02 = \"SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_SYNTHETIC_LONG_M_02_\",\r\n  Pad03 = \"SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_SYNTHETIC_LONG_M_03_\",\r\n  Pad04 = \"SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_LONG_M_04_SYNTHETIC_
     "name": "Sales YoY",
     "dax": "// year over year delta\nVAR _cur = [Total Sales]\nVAR _prev = CALCULATE([Total Sales], DATEADD('Dim Date'[Date], -1, YEAR))\nRETURN\n\t_cur - _prev\n",

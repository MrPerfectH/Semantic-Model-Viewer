table 'Fact Sales'
	lineageTag: 11111111-1111-1111-1111-111111111111

	measure 'Total Sales' = SUM('Fact Sales'[Amount])
		formatString: #,0
		displayFolder: Sales\Base
		lineageTag: 22222222-2222-2222-2222-222222222222

	measure 'Sales YoY' =
			// year over year delta
			VAR _cur = [Total Sales]
			VAR _prev = CALCULATE([Total Sales], DATEADD('Dim Date'[Date], -1, YEAR))
			RETURN
				_cur - _prev
		formatString: #,0
		displayFolder: Sales\Time
		isHidden

	measure Margin% = DIVIDE([Total Sales] - SUM('Fact Sales'[Cost]), [Total Sales])
		formatString: 0.0%

	measure 'Broken Measure' = [Does Not Exist] + 1

	column Amount
		dataType: decimal
		summarizeBy: sum
		sourceColumn: Amount

	column Cost
		dataType: decimal
		isHidden
		sourceColumn: Cost

	column 'Order Date'
		dataType: dateTime
		sourceColumn: Order Date

	column 'Ship Date'
		dataType: dateTime
		sourceColumn: Ship Date

	column ProductKey
		dataType: int64
		isHidden
		sourceColumn: ProductKey

	column Region
		dataType: string
		sourceColumn: Region

	column Margin = [Amount] - [Cost]
		dataType: decimal

	partition 'Fact Sales' = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs("adb-1.azuredatabricks.net", "/sql/1.0/warehouses/abc", []),
				    db = Source{[Name="finance",Kind="Schema"]}[Data],
				    tbl = db{[Name="fact_sales",Kind="Table"]}[Data]
				in
				    tbl
